# {{ ansible_managed }}
# Rendered for the "{{ ttc_env_name }}" environment. Do not edit by hand; re-run
# `make deploy-dev` / `make deploy-prod` (or the Ansible playbook) to regenerate.

# --- Isolation ---------------------------------------------------------------
# Ownership leases: <OWNERSHIP_PREFIX>/<role>.json. Production and development
# are isolated by this prefix and the R2 bucket, never by renaming the fixed
# capture/diagnostic object prefixes.
OWNERSHIP_PREFIX={{ ttc_ownership_prefix }}

# --- R2 object store (bucket/region are not secrets) -------------------------
R2_BUCKET={{ ttc_r2_bucket }}
R2_REGION={{ ttc_r2_region }}

# --- Service tuning ----------------------------------------------------------
{% for key, value in ttc_runtime_env.items() %}
{{ key }}={{ value }}
{% endfor %}
TTC_BUILD_VERSION={{ ttc_image_tag }}

# --- Secrets (appended from deploy/{{ ttc_secrets_name }}.env on the control host)
{{ ttc_secrets_text }}
