# Story 64 — environment for the Compose TTC capture stack.
#
# Copy to a file named `.env` (gitignored) next to compose.yaml and fill in the
# R2 credentials. Never commit real credentials.
#
# Production and development are isolated by the *prefix* and *bucket*, so a
# development stack can run against a scratch bucket and never contend with the
# production writer's ownership lease or capture objects. Pointing a dev stack at
# the production bucket with the production prefix would re-introduce the
# single-writer hazard this interlock exists to prevent.

# --- R2 (required) -----------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=sirento
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_REGION=auto

# --- Isolation prefixes (dev must differ from production) ----------------------
# Ownership leases: <OWNERSHIP_PREFIX>/<role>.json
# Raw captures:     <CAPTURE_PREFIX>/<feedId>/<padded>.json + .pb
# Failure bundles:  <DIAGNOSTIC_PREFIX>/<feedId>/<padded>.json
# Production defaults are shown; a development stack MUST override these to a
# distinct prefix (e.g. dev/ttc-ownership, dev/ttc-captures, dev/ttc-diagnostics)
# and use a scratch bucket.
OWNERSHIP_PREFIX=ttc-ownership
CAPTURE_PREFIX=ttc-captures
DIAGNOSTIC_PREFIX=ttc-diagnostics

# --- Collector ----------------------------------------------------------------
TTC_INTERVAL_MS=30000
TTC_SPOOL_LIMIT=720

# --- Advisory context (optional) ----------------------------------------------
# Path to the published incident snapshot for official alert-support context.
# Leave empty to run without advisory context (a `not-loaded` contract).
TTC_ADVISORY_SNAPSHOT=
