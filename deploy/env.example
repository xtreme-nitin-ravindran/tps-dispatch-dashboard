# environment for the Compose TTC capture stack.
#
# Copy to a file named `.env` (gitignored) next to compose.yaml and fill in the
# R2 credentials. Never commit real credentials.
#
# Production and development are isolated by the *R2 bucket* and the
# *ownership prefix*: a development stack must use a scratch bucket and a
# distinct OWNERSHIP_PREFIX, so it never contends with the production writer's
# ownership lease or capture objects. The capture (`ttc-captures/`) and
# diagnostic (`ttc-diagnostics/`) object prefixes are fixed in code; pointing a
# dev stack at the production bucket re-introduces the single-writer hazard
# this interlock exists to prevent, regardless of any prefix setting.

# --- R2 (required) -----------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=sirento
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_REGION=auto

# --- Isolation (dev must differ from production) -------------------------------
# Ownership leases: <OWNERSHIP_PREFIX>/<role>.json. Raw captures and failure
# bundles live under the fixed `ttc-captures/` and `ttc-diagnostics/` prefixes.
# A development stack MUST use a scratch R2_BUCKET and a distinct ownership
# prefix (e.g. dev/ttc-ownership).
OWNERSHIP_PREFIX=ttc-ownership

# --- Service tuning -----------------------------------------------------------
TTC_INTERVAL_MS=30000
TTC_SPOOL_LIMIT=720
# Loopback health ports (collector 8764, processor 8765; never published).
TTC_HEALTH_PORT=8764
# Processor drain cadence (one ordered-discovery LIST per drain).
TTC_DRAIN_INTERVAL_MS=30000
# Where spooled diagnostic bundles wait out an R2 outage (retried hourly).
TTC_DIAGNOSTIC_SPOOL_DIR=/app/spool/diagnostics
# Recorded into diagnostic bundles for exact replay.
TTC_BUILD_VERSION=unversioned

# --- Advisory context (optional) ----------------------------------------------
# Path to the published incident snapshot for official alert-support context.
# Leave empty to run without advisory context (a `not-loaded` contract).
TTC_ADVISORY_SNAPSHOT=
