# local R2 credentials for the TTC capture service deployment.
#
# Copy this file to `deploy/secrets.env` (gitignored) and fill in the real
# values. Only this `.example` is committed; never commit real credentials.
#
# The Ansible playbook reads `deploy/secrets.env` (or, for the production
# inventory group, `deploy/secrets.production.env`) from the control host and
# appends these values to the Compose `.env` it renders on the target host. The
# R2 bucket and region are not secrets and live in the Ansible group_vars
# (`deploy/ansible/inventory/group_vars/{dev,production}.yml`), because the bucket
# and the ownership prefix are the production/development isolation boundary.

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
