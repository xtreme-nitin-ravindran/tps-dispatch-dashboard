{
    "name": "toronto-dispatch-dashboard",
    "private": true,
    "license": "LicenseRef-Spaghetti",
    "type": "module",
    "scripts": {
        "verify": "sh scripts/verify.sh",
        "verify:fast": "sh scripts/verify.sh --fast",
        "lint": "npm run lint:js && npm run lint:python",
        "lint:js": "eslint .",
        "lint:python": "ruff check scripts test/python",
        "test": "sh scripts/run-unit-tests.sh",
        "test:watch-backend": "node --test test/watch-backend.test.js",
        "test:watch-production": "node --test test/watch-production-backend.test.js test/push-subscription.test.js",
        "test:watch-matching": "node --test test/watch-matching-backend.test.js test/watch-matcher.test.js",
        "fixture:watch-matching": "node test/fixtures/run-watch-matching.js",
        "test:watch-delivery": "node --test test/watch-delivery.test.js",
        "fixture:watch-delivery": "node test/fixtures/run-watch-delivery.js",
        "test:notification-ux": "node --test test/notification-ux.test.js test/service-worker.test.js test/watch-delivery.test.js",
        "test:story-38g": "node --test test/police-boundary-overlay.test.js test/police-boundary-lifecycle.test.js test/marker-clustering.test.js test/mobile-selected-incident.test.js test/mobile-audit-fixture.test.js test/mobile-bottom-sheet.test.js test/mobile-view-toggle.test.js test/mobile-compositing.test.js test/disruptions.test.js test/service-worker.test.js",
        "test:story-39a:browser": "node scripts/cluster-connectors-browser.js",
        "test:story-40e:browser": "node scripts/mobile-focus-browser.js",
        "test:road-closure-count:browser": "node scripts/road-closure-count-browser.js",
        "test:story-42:browser": "node scripts/mobile-sheet-header-browser.js",
        "test:story-43:browser": "node scripts/mobile-map-info-browser.js",
        "fixture:notification-ux": "node test/fixtures/run-notification-ux.js",
        "bump:asset-version": "node scripts/bump-asset-version.js",
        "test:coverage": "sh scripts/run-unit-tests.sh --coverage",
        "test:python": "python3 -m unittest discover -s test/python -v",
        "test:integration": "node --test test/*-source.integration.test.js",
        "update:tfs": "node scripts/tfs-etl.js",
        "test:watch": "node --test --watch",
        "test:ttc": "node --test test/ttc-gtfs-alerts.test.js test/ttc-static.test.js test/ttc-vehicles.test.js test/ttc-diversions.test.js",
        "update:ttc": "node scripts/ttc-alerts.js",
        "test:ttc:live": "node scripts/ttc-alerts.js --smoke",
        "update:ttc:static": "node scripts/ttc-static.js",
        "update:ttc:vehicles": "node scripts/ttc-vehicles.js",
        "fixture:ttc:diversions": "node test/fixtures/ttc-diversions/run.js",
        "test:ttc:diversions:live": "node scripts/ttc-vehicles.js --polls 4 --geojson .cache/ttc/diversions.geojson",
        "test:ttc:vehicles:live": "node scripts/ttc-vehicles.js --polls 4",
        "fixture:ttc:ui": "node scripts/ttc-ui-fixture.js"
    },
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.12.0",
        "globals": "17.13.0"
    },
    "dependencies": {
        "gtfs-realtime-bindings": "2.2.0"
    }
}
