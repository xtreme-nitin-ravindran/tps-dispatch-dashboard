# TTC GTFS-RT vehicle-capture test credentials.
#
# Copy this file to `scripts/e2e.env` (gitignored) and fill in the real values.
# Only this `.example` is committed; never commit real credentials.
#
# The e2e harness (`scripts/e2e.sh`) sources `scripts/e2e.env` by default
# (relative filename, mirroring deploy/secrets.env). Override with
# E2E_CREDS_FILE=<path>. Only key names are referenced in the script, never a
# secret value or an absolute path.

# --- Cloudflare R2 (object store) --------------------------------------------
# The S3-compatible endpoint plus object-level access key/secret. The harness
# uses a fixed scratch bucket (`rotato-e2e-scratch`, overridable with
# E2E_R2_BUCKET) and empties it before each run; it never creates or deletes a
# bucket, so no Cloudflare admin API token is needed.
#
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are an R2 S3 API token (id + value) for
# object read/write/list, scoped to the scratch bucket — created in Cloudflare
# dashboard at R2 -> Manage R2 API Tokens.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_S3_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_S3_ACCESS_KEY_SECRET
R2_REGION=auto
