# TTC GTFS-RT vehicle-capture test credentials.
#
# Copy this file to `scripts/e2e.env` (gitignored) and fill in the real values.
# Only this `.example` is committed; never commit real credentials.
#
# The e2e harness (`scripts/e2e.sh`) sources `scripts/e2e.env` by default
# (relative filename, mirroring deploy/secrets.env). Override with
# E2E_CREDS_FILE=<path>. Only key names are referenced in the script, never a
# secret value or an absolute path.

# --- Cloudflare R2 (object store) --------------------------------------------
# The S3-compatible endpoint plus object-level access key/secret. The harness
# never reuses the production `sirento` bucket; it creates (and later deletes) a
# fresh scratch bucket.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_REGION=auto

# --- Cloudflare API token (bucket create/delete) ------------------------------
# Required only to create/delete the scratch bucket (the object-level creds above
# cannot create or delete a bucket). Omit it and set E2E_R2_BUCKET=<existing
# scratch bucket> instead if you already have one.
CF_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
